# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# Supports a single key OR comma-separated multiple keys for automatic 429 quota fallback across accounts:
# GEMINI_API_KEY=AIzaSyA...,AIzaSyB...,AIzaSyC...
GEMINI_API_KEY=your_gemini_api_key_here
# KAN-848: set to 1 so Episodes use only the Claude and agy CLIs; the Gemini API is never called and the key is ignored.
# GEMINI_CLI_ONLY=1

# YouTube Data API v3 key (Google Cloud Console > APIs & Services > enable "YouTube Data API v3" > Credentials > API key).
# Used by the Kids Shorts trend scan and Channel performance scan.
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube Channel ID to scan (starts with UC...)
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# ComfyUI Host URL (defaults to http://127.0.0.1:8188 if not specified)
# For remote host or Hamachi, set to the remote machine's IP, e.g. http://25.8.51.103:8188
COMFYUI_URL=http://127.0.0.1:8188

# Narrative Factory API URL (defaults to http://127.0.0.1:5050)
NARRATIVE_FACTORY_URL=http://127.0.0.1:5050

# n8n Automation Engine URL (defaults to http://localhost:5678)
N8N_URL=http://localhost:5678

# ==============================================================================
# Remote Voiceover & TTS Worker Configuration (KAN-163)
# ==============================================================================
# TTS_URL: Target URL of the Narrative Factory / TTS worker service.
# - Local default: http://127.0.0.1:5050 (or NARRATIVE_FACTORY_URL)
# - Remote worker: http://<LAN_OR_VPN_IP>:5050 (e.g. http://192.168.1.50:5050 or http://25.8.51.103:5050)
TTS_URL=http://127.0.0.1:5050

# TTS_TOKEN: Shared secret authentication token between ForgeAi and Narrative Factory TTS worker.
# - When running scripts/start_remote_tts.py on a GPU machine, TTS_TOKEN must be set to this same secret.
# - The server includes this token in the 'X-TTS-Token' header on all POST synthesis requests.
# - Worker fails closed (401 Unauthorized) if token does not match.
# - Example: generate with `openssl rand -hex 16`
TTS_TOKEN=your_shared_tts_secret_token_here

