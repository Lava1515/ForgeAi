{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Path Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "skills"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "skills": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill", "mode"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$", "description": "The validator also requires a non-blank, non-whitespace value and unique entry ids within the pack." },
          "skill": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "mode": { "enum": ["digest", "guidance_only"] },
          "files": { "type": "array", "maxItems": 64, "description": "The validator additionally requires each reference to be relative, to exist, and to resolve inside the skill folder; symlinks, junctions, and reparse points are rejected. The referenced skill's SKILL.md must be at most 256 KB.", "items": { "type": "string", "minLength": 1, "description": "A relative path to an existing file inside the skill folder." } }
        }
      }
    },
    "rules": {
      "description": "Optional plain JSON rule table. The validator additionally enforces a 32 KB serialized limit, maximum depth 6, strings up to 2,000 characters, arrays up to 100 items, objects up to 200 properties, and no prototype-related keys.",
      "type": "object",
      "properties": {
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overlay": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "direction",
                "render"
              ],
              "properties": {
                "direction": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "minPlaces": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "maxPlaces": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "maxShotSeconds": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "render": {
                  "type": "object",
                  "required": [
                    "engine",
                    "device",
                    "viewTransform",
                    "look",
                    "samples",
                    "status",
                    "RENDER_BUDGET_S_PER_FRAME"
                  ],
                  "properties": {
                    "engine": {
                      "const": "CYCLES"
                    },
                    "device": {
                      "const": "GPU"
                    },
                    "viewTransform": {
                      "type": "string"
                    },
                    "look": {
                      "type": "string"
                    },
                    "samples": {
                      "type": "integer",
                      "minimum": 8,
                      "maximum": 16
                    },
                    "status": {
                      "const": "pending_review"
                    },
                    "source": {
                      "type": "string"
                    },
                    "measuredSecondsPerFrame": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "maxFinalMinutes": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "Optional authored final-render forecast ceiling in minutes. Uses the accepted preview timing; missing timing stops the job. Equality is allowed. codex - gpt-6.1-sol - 2026-11-18 11:57 +02:00"
                    },
                    "RENDER_BUDGET_S_PER_FRAME": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "formats": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "skills": { "type": "array", "items": { "type": "string" } },
              "steps": { "type": "array", "items": { "type": "string" } },
              "sets": { "type": "array", "items": { "type": "string" } },
              "setSteps": { "type": "array", "items": { "type": "string" } },
              "note": { "type": "string" },
              "overlay": { "type": "boolean" },
              "direction": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minPlaces": { "type": "integer", "minimum": 1 },
                  "maxPlaces": { "type": "integer", "minimum": 1 },
                  "maxShotSeconds": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  }
}
